index 6308d70..1bbd32a 100644
--- a/src/vulkan/wsi/wsi_common_metal_layer.m
+++ b/src/vulkan/wsi/wsi_common_metal_layer.m
@@ -11,6 +11,9 @@
 #import <QuartzCore/CAMetalLayer.h>
 #import <Metal/Metal.h>
 
+#include <pthread.h>
+#include <stdlib.h>
+
 void
 wsi_metal_layer_size(const CAMetalLayer *metal_layer,
    uint32_t *width, uint32_t *height)
@@ -282,6 +285,98 @@ wsi_metal_release_drawable(CAMetalDrawable *drawable_ptr)
    [(id<CAMetalDrawable>)drawable_ptr release];
 }
 
+struct wsi_metal_drawable_prefetch {
+   CAMetalLayer *layer;
+   pthread_t thread;
+   pthread_mutex_t mutex;
+   pthread_cond_t cond;
+   id<CAMetalDrawable> drawable;
+   bool stop;
+};
+
+static void *
+wsi_metal_drawable_prefetch_main(void *data)
+{
+   struct wsi_metal_drawable_prefetch *prefetch = data;
+   pthread_setname_np("wsi-metal-drawable");
+   pthread_mutex_lock(&prefetch->mutex);
+   while (!prefetch->stop) {
+      if (prefetch->drawable) {
+         pthread_cond_wait(&prefetch->cond, &prefetch->mutex);
+         continue;
+      }
+      pthread_mutex_unlock(&prefetch->mutex);
+      id<CAMetalDrawable> drawable = nil;
+      @autoreleasepool {
+         /* Blocks until the compositor returns a drawable (or 1 s). */
+         drawable = [[prefetch->layer nextDrawable] retain];
+      }
+      pthread_mutex_lock(&prefetch->mutex);
+      if (prefetch->stop) {
+         [drawable release];
+         break;
+      }
+      prefetch->drawable = drawable;
+   }
+   pthread_mutex_unlock(&prefetch->mutex);
+   return NULL;
+}
+
+struct wsi_metal_drawable_prefetch *
+wsi_metal_drawable_prefetch_create(const CAMetalLayer *metal_layer)
+{
+   struct wsi_metal_drawable_prefetch *prefetch = calloc(1, sizeof(*prefetch));
+   if (!prefetch)
+      return NULL;
+   prefetch->layer = [(CAMetalLayer *)metal_layer retain];
+   pthread_mutex_init(&prefetch->mutex, NULL);
+   pthread_cond_init(&prefetch->cond, NULL);
+   if (pthread_create(&prefetch->thread, NULL, wsi_metal_drawable_prefetch_main,
+                      prefetch) != 0) {
+      pthread_cond_destroy(&prefetch->cond);
+      pthread_mutex_destroy(&prefetch->mutex);
+      [prefetch->layer release];
+      free(prefetch);
+      return NULL;
+   }
+   return prefetch;
+}
+
+CAMetalDrawable *
+wsi_metal_drawable_prefetch_take(struct wsi_metal_drawable_prefetch *prefetch,
+                                 uint32_t width, uint32_t height)
+{
+   pthread_mutex_lock(&prefetch->mutex);
+   id<CAMetalDrawable> drawable = prefetch->drawable;
+   prefetch->drawable = nil;
+   pthread_cond_signal(&prefetch->cond);
+   pthread_mutex_unlock(&prefetch->mutex);
+   /* A drawable fetched before a resize has the old size; drop it. */
+   if (drawable && (drawable.texture.width != width ||
+                    drawable.texture.height != height)) {
+      [drawable release];
+      drawable = nil;
+   }
+   return (CAMetalDrawable *)drawable;
+}
+
+void
+wsi_metal_drawable_prefetch_destroy(struct wsi_metal_drawable_prefetch *prefetch)
+{
+   if (!prefetch)
+      return;
+   pthread_mutex_lock(&prefetch->mutex);
+   prefetch->stop = true;
+   pthread_cond_signal(&prefetch->cond);
+   pthread_mutex_unlock(&prefetch->mutex);
+   pthread_join(prefetch->thread, NULL);
+   [prefetch->drawable release];
+   [prefetch->layer release];
+   pthread_cond_destroy(&prefetch->cond);
+   pthread_mutex_destroy(&prefetch->mutex);
+   free(prefetch);
+}
+
 void
 wsi_metal_layer_add_presented_handler(CAMetalDrawable *drawable_ptr,
                                       void (*presented_handler)(void *, uint64_t),
