\ No newline at end of file
+}
+// Rosetta can enter the translator with live guest SIMD registers. The
+// original translator preserves those values, but compiler-generated NEON
+// in our hook (for example X87Cache::perm initialization) may overwrite them.
+// Save at an assembly boundary so the optimizer cannot move SIMD work ahead
+// of the save. This cost is paid during translation, not per guest operation.
+__attribute__((naked))
+int64_t hook_translate_insn(TranslationResult*, IRBlock*, IRInstr*, int64_t, int64_t) {
+    __asm__ volatile(
+        "sub sp, sp, #544\n"
+        "stp q0, q1, [sp, #0]\n"
+        "stp q2, q3, [sp, #32]\n"
+        "stp q4, q5, [sp, #64]\n"
+        "stp q6, q7, [sp, #96]\n"
+        "stp q8, q9, [sp, #128]\n"
+        "stp q10, q11, [sp, #160]\n"
+        "stp q12, q13, [sp, #192]\n"
+        "stp q14, q15, [sp, #224]\n"
+        "stp q16, q17, [sp, #256]\n"
+        "stp q18, q19, [sp, #288]\n"
+        "stp q20, q21, [sp, #320]\n"
+        "stp q22, q23, [sp, #352]\n"
+        "stp q24, q25, [sp, #384]\n"
+        "stp q26, q27, [sp, #416]\n"
+        "stp q28, q29, [sp, #448]\n"
+        "stp q30, q31, [sp, #480]\n"
+        "str x29, [sp, #512]\n"
+        "str x30, [sp, #520]\n"
+        "mrs x16, fpcr\n"
+        "str x16, [sp, #528]\n"
+        "mrs x16, fpsr\n"
+        "str x16, [sp, #536]\n"
+        "bl _hook_translate_insn_impl\n"
+        "ldr x16, [sp, #528]\n"
+        "msr fpcr, x16\n"
+        "ldr x16, [sp, #536]\n"
+        "msr fpsr, x16\n"
+        "ldp q0, q1, [sp, #0]\n"
+        "ldp q2, q3, [sp, #32]\n"
+        "ldp q4, q5, [sp, #64]\n"
+        "ldp q6, q7, [sp, #96]\n"
+        "ldp q8, q9, [sp, #128]\n"
+        "ldp q10, q11, [sp, #160]\n"
+        "ldp q12, q13, [sp, #192]\n"
+        "ldp q14, q15, [sp, #224]\n"
+        "ldp q16, q17, [sp, #256]\n"
+        "ldp q18, q19, [sp, #288]\n"
+        "ldp q20, q21, [sp, #320]\n"
+        "ldp q22, q23, [sp, #352]\n"
+        "ldp q24, q25, [sp, #384]\n"
+        "ldp q26, q27, [sp, #416]\n"
+        "ldp q28, q29, [sp, #448]\n"
+        "ldp q30, q31, [sp, #480]\n"
+        "ldr x29, [sp, #512]\n"
+        "ldr x30, [sp, #520]\n"
+        "add sp, sp, #544\n"
+        "ret\n");
+}
