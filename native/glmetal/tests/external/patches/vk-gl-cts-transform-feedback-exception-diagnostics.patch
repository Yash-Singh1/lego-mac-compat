 #include <cmath>
 #include <cstdlib>
 #include <sstream>
+
+/* Preserve the exception details without changing the existing test verdict. */
+static void logTransformFeedbackException(tcu::TestLog &log, const char *function, int line)
+{
+    try
+    {
+        throw;
+    }
+    catch (const tcu::Exception &error)
+    {
+        log << tcu::TestLog::Message << function << ":" << line << ": " << error.what()
+            << tcu::TestLog::EndMessage;
+    }
+    catch (const std::exception &error)
+    {
+        log << tcu::TestLog::Message << function << ":" << line << ": " << error.what()
+            << tcu::TestLog::EndMessage;
+    }
+    catch (...)
+    {
+        log << tcu::TestLog::Message << function << ":" << line << ": Unknown non-standard exception"
+            << tcu::TestLog::EndMessage;
+    }
+}
 
